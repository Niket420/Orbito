# Copy to backend/.env and adjust. Never put AWS keys in this file;
# use the standard AWS credential chain (aws configure / AWS_PROFILE / SSO).

# Local server. The host is always forced to loopback (127.0.0.1).
WHISPER_PORT=8765

# Optional: API token shared with the macOS app. When unset, the token is read
# from (or created in) ~/Library/Application Support/Whisper/api-token (0600).
# WHISPER_API_TOKEN=

# LLM provider: auto | bedrock | mock
# "auto" uses Bedrock when a model ID and AWS credentials are available,
# otherwise the labelled mock planner.
WHISPER_LLM_PROVIDER=auto

# AWS Bedrock. Pick a model ID enabled in your AWS account that supports the
# Converse API with tool use. There is intentionally no default.
# AWS_REGION=us-east-1
# AWS_PROFILE=default
WHISPER_BEDROCK_MODEL_ID=
WHISPER_BEDROCK_TIMEOUT_SECONDS=30

# Speech provider: auto | whistle | mock
WHISPER_SPEECH_PROVIDER=auto

WHISPER_LOG_LEVEL=INFO
