# Template only. Copy to backend/.env (git-ignored) and put real values there.
# Never put real keys in this file: it is committed to git.

# Local server. The host is always forced to loopback (127.0.0.1).
ORBITO_PORT=8765

# Optional: API token shared with the macOS app. When unset, the token is read
# from (or created in) ~/Library/Application Support/Orbito/api-token (0600).
# ORBITO_API_TOKEN=

# LLM provider: auto | groq | bedrock | mock
# "auto" uses the first fully configured provider (Bedrock, then Groq),
# otherwise the labelled mock planner.
ORBITO_LLM_PROVIDER=auto

# Groq: needs an API key and a model that supports tool calling.
# GROQ_API_KEY=
# ORBITO_GROQ_MODEL_ID=openai/gpt-oss-120b
ORBITO_GROQ_TIMEOUT_SECONDS=30

# AWS Bedrock: credentials from an AWS profile (aws configure / SSO) or a
# Bedrock API key, plus a model ID that supports the Converse API with tool use.
# AWS_REGION=us-east-1
# AWS_PROFILE=default
# AWS_BEARER_TOKEN_BEDROCK=
# ORBITO_BEDROCK_MODEL_ID=
ORBITO_BEDROCK_TIMEOUT_SECONDS=30

# Speech provider: auto | whistle | mock
ORBITO_SPEECH_PROVIDER=auto

ORBITO_LOG_LEVEL=INFO
